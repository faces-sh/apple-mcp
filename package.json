{
  "name": "apple-mcp",
  "version": "1.1.0-faces.2",
  "type": "module",
  "description": "Apple MCP server for Contacts, Messages, Notes, Reminders, and Calendar. Faces fork: JXA (real structured returns), honest permission errors, per-app filtering, no script injection.",
  "author": "Dhravya Shah; Faces fork by faces.sh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faces-sh/apple-mcp.git"
  },
  "keywords": [
    "mcp",
    "apple",
    "contacts",
    "messages",
    "notes",
    "reminders",
    "calendar"
  ],
  "bin": {
    "apple-mcp": "./dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "index.ts",
    "tools.ts",
    "utils",
    "tsconfig.json",
    "LICENSE",
    "README.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@jxa/global-type": "^1.3.6",
    "@types/bun": "1.4.0",
    "@types/node": "^22.13.4",
    "esbuild": "^0.28.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@jxa/run": "^1.3.6",
    "@modelcontextprotocol/sdk": "^1.5.0",
    "libphonenumber-js": "^1.13.7",
    "run-applescript": "^7.0.0"
  }
}
